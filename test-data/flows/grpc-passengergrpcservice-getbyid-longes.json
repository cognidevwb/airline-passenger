{
  "id": "grpc-passengergrpcservice-getbyid-longes",
  "title": "Longest passport number",
  "source": "staged scenario",
  "why": "Checks the 10-character passport limit is stored and returned without truncation.",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 39,
        "CreatedAt": "2026-04-01T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111110",
        "IsDeleted": false,
        "LastModified": "2026-04-01T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Long Passport",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Call gRPC PassengerGrpcService/GetById with Id 11111111-1111-4111-8111-111111111110."
    }
  ],
  "expect": [
    "OK response with PassportNumber exactly 'AB12345678' (10 characters, not truncated)."
  ]
}
