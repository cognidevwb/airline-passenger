{
  "id": "get-passenger-id-longest-passport-number",
  "title": "Longest passport number",
  "source": "staged scenario",
  "why": "Checks the 10-character passport boundary is accepted and returned",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 38,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111110",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Omar Haddad",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111110"
    }
  ],
  "expect": [
    "200 OK with PassportNumber 'AB12345678' intact"
  ]
}
