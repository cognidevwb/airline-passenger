{
  "id": "get-passenger-id-details-match-the-store",
  "title": "Details match the stored record",
  "source": "staged scenario",
  "why": "Ensures no field is altered or mixed up between storage and response",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 52,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111108",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Hiroshi Tanaka",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111108"
    }
  ],
  "expect": [
    "200 OK where Name 'Hiroshi Tanaka', passport 'K9876543' and type Male equal the stored values exactly"
  ]
}
