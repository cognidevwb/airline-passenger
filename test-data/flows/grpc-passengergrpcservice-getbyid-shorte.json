        "Age": 25,
        "CreatedAt": "2026-04-02T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111111",
        "IsDeleted": false,
        "LastModified": "2026-04-02T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Short Passport",
        "PassengerType": "Female",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Call gRPC PassengerGrpcService/GetById with Id 11111111-1111-4111-8111-111111111111."
    }
  ],
  "expect": [
    "OK response with PassportNumber 'X'."
  ]
