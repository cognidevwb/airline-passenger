{
  "id": "get-passenger-id-view-a-passenger-with-e",
  "title": "View a passenger with edit history",
  "source": "staged scenario",
  "why": "Checks audit and version fields are carried through for an edited record",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 41,
        "CreatedAt": "2026-01-05T09:00:00Z",
        "CreatedBy": 7,
        "Id": "11111111-1111-4111-8111-111111111104",
        "IsDeleted": false,
        "LastModified": "2026-03-15T14:30:00Z",
        "LastModifiedBy": 42,
        "Name": "Priya Nair",
        "PassengerType": "Female",
        "PassportNumber": "X90000000",
        "Version": 3
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111104"
    }
  ],
  "expect": [
    "200 OK with Version 3, LastModified later than CreatedAt, LastModifiedBy 42"
  ]
}
