{
  "id": "grpc-passengergrpcservice-getbyid-baby-t",
  "title": "Baby type with an adult age",
  "source": "staged scenario",
  "why": "Shows the lookup does no cross-field validation and returns stored data exactly as it is.",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 45,
        "CreatedAt": "2026-05-01T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111115",
        "IsDeleted": false,
        "LastModified": "2026-05-01T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Mismatch Max",
        "PassengerType": "Baby",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Call gRPC PassengerGrpcService/GetById with Id 11111111-1111-4111-8111-111111111115."
    }
  ],
  "expect": [
    "OK response with PassengerType Baby and Age 45 unchanged; no validation error."
  ]
}
