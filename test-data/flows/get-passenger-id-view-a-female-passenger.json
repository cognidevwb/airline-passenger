        "LastModifiedBy": 1,
        "Name": "Maria Lopez",
        "PassengerType": "Female",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111102"
