{
  "id": "get-passenger-id-passenger-id-does-not-e",
  "title": "Passenger id does not exist",
  "source": "staged scenario",
  "why": "Confirms a well-formed but unmatched id yields not found",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 33,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111114",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Other Person",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/99999999-9999-4999-8999-999999999999 (no such row)"
    }
  ],
  "expect": [
    "404 not found; no passenger data returned"
  ]
}
