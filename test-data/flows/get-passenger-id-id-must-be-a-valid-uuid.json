{
  "id": "get-passenger-id-id-must-be-a-valid-uuid",
  "title": "Id must be a valid uuid",
  "source": "staged scenario",
  "why": "Confirms a malformed route value is rejected before any lookup",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 30,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111106",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Some Passenger",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/not-a-guid"
    }
  ],
  "expect": [
    "Rejected with a 400 bad request for the invalid Id; the database is not queried"
  ]
}
