{
  "id": "grpc-passengergrpcservice-getbyid-same-n",
  "title": "Same name, different passenger",
  "source": "staged scenario",
  "why": "Confirms lookup is by Id only, so two passengers sharing a name are never mixed up.",
  "setup": [
    {
      "ref": "john-a",
      "table": "Passenger",
      "values": {
        "Age": 34,
        "CreatedAt": "2026-06-01T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111116",
        "IsDeleted": false,
        "LastModified": "2026-06-01T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "John Smith",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    },
    {
      "ref": "john-b",
      "table": "Passenger",
      "values": {
        "Age": 62,
        "CreatedAt": "2026-06-02T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111117",
        "IsDeleted": false,
        "LastModified": "2026-06-02T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "John Smith",
        "PassengerType": "Male",
        "PassportNumber": "X90000001",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Call gRPC PassengerGrpcService/GetById once with Id 11111111-1111-4111-8111-111111111116 and once with Id 11111111-1111-4111-8111-111111111117."
    }
  ],
  "expect": [
    "The first call returns passport 'JS111111' and Age 34; the second returns passport 'JS222222' and Age 62. Each response carries its own Id."
  ]
}
