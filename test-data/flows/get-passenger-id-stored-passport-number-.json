{
  "id": "get-passenger-id-stored-passport-number-",
  "title": "Stored passport number is invalid",
  "source": "staged scenario",
  "why": "Shows an over-length stored passport number is caught on load instead of returned",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 30,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111118",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Bad Passport",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111118"
    }
  ],
  "expect": [
    "Fails with an invalid-passport-number error when the record is loaded; no passenger returned"
  ]
}
