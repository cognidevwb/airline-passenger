{
  "id": "get-passenger-id-deleted-passenger-is-no",
  "title": "Deleted passenger is not shown",
  "source": "staged scenario",
  "why": "Verifies soft-deleted passengers are hidden from lookups",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 50,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111107",
        "IsDeleted": true,
        "LastModified": "2026-02-01T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Deleted Person",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 2
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111107"
    }
  ],
  "expect": [
    "Treated as not found (404); no passenger details returned"
  ]
}
