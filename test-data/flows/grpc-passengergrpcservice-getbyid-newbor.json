{
  "id": "grpc-passengergrpcservice-getbyid-newbor",
  "title": "Newborn age zero",
  "source": "staged scenario",
  "why": "Checks Age 0 is returned as a real value and not mistaken for missing.",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 0,
        "CreatedAt": "2026-10-23T08:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111114",
        "IsDeleted": false,
        "LastModified": "2026-10-23T08:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Newborn Ng",
        "PassengerType": "Baby",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Call gRPC PassengerGrpcService/GetById with Id 11111111-1111-4111-8111-111111111114."
    }
  ],
  "expect": [
    "OK response with PassengerType Baby, Age 0 and CreatedAt 2026-10-23."
  ]
}
