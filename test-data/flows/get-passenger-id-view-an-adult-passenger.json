{
  "id": "get-passenger-id-view-an-adult-passenger",
  "title": "View an adult passenger",
  "source": "staged scenario",
  "why": "Confirms a stored adult passenger is returned with all of their details",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 34,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111101",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "James Carter",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111101"
    }
  ],
  "expect": [
    "200 OK with Name 'James Carter', passport 'P1234567', type Male, age 34"
  ]
}
