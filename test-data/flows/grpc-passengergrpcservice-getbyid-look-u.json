{
  "id": "grpc-passengergrpcservice-getbyid-look-u",
  "title": "Look up an adult male passenger",
  "source": "staged scenario",
  "why": "Confirms GetById returns every stored field for an ordinary adult male passenger.",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 34,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111101",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "John Smith",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Call gRPC PassengerGrpcService/GetById with Id 11111111-1111-4111-8111-111111111101."
    }
  ],
  "expect": [
    "OK response with Name 'John Smith', PassengerType Male, Age 34, PassportNumber 'P1234567' and the same Id."
  ]
}
