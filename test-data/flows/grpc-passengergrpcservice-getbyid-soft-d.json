{
  "id": "grpc-passengergrpcservice-getbyid-soft-d",
  "title": "Soft-deleted passenger is not returned",
  "source": "staged scenario",
  "why": "Verifies the soft-delete filter hides logically deleted rows from lookups.",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 45,
        "CreatedAt": "2026-01-15T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111107",
        "IsDeleted": true,
        "LastModified": "2026-09-01T10:00:00Z",
        "LastModifiedBy": 2,
        "Name": "Deleted Dan",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 2
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "Call gRPC PassengerGrpcService/GetById with Id 11111111-1111-4111-8111-111111111107."
    }
  ],
  "expect": [
    "gRPC NOT_FOUND status; the soft-deleted passenger's data is not returned."
  ]
}
