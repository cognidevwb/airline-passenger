{
  "id": "get-passenger-id-unknown-passenger-type",
  "title": "Unknown passenger type",
  "source": "staged scenario",
  "why": "Confirms the Unknown enum value is returned rather than rejected",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 30,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111113",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Alex Morgan",
        "PassengerType": "Unknown",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111113"
    }
  ],
  "expect": [
    "200 OK with PassengerType Unknown and the rest of the record intact"
  ]
}
