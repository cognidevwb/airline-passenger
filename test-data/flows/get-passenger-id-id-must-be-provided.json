{
  "id": "get-passenger-id-id-must-be-provided",
  "title": "Id must be provided",
  "source": "staged scenario",
  "why": "Confirms an empty Guid is rejected rather than looked up",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 30,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111105",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Some Passenger",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/00000000-0000-0000-0000-000000000000"
    }
  ],
  "expect": [
    "Rejected as a validation error (400) stating the Id must be provided; no passenger returned"
  ]
}
