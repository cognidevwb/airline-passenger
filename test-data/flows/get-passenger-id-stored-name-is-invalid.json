{
  "id": "get-passenger-id-stored-name-is-invalid",
  "title": "Stored name is invalid",
  "source": "staged scenario",
  "why": "Shows a blank stored name is caught on load instead of returned",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": 30,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111117",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "",
        "PassengerType": "Female",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111117"
    }
  ],
  "expect": [
    "Fails with an invalid-name error when the record is loaded; no passenger returned"
  ]
}
