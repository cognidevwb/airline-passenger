{
  "id": "get-passenger-id-stored-age-is-invalid",
  "title": "Stored age is invalid",
  "source": "staged scenario",
  "why": "Shows a corrupt stored age is caught on load instead of returned",
  "setup": [
    {
      "ref": "passenger-1",
      "table": "Passenger",
      "values": {
        "Age": -5,
        "CreatedAt": "2026-01-10T09:00:00Z",
        "CreatedBy": 1,
        "Id": "11111111-1111-4111-8111-111111111116",
        "IsDeleted": false,
        "LastModified": "2026-01-10T09:00:00Z",
        "LastModifiedBy": 1,
        "Name": "Bad Age",
        "PassengerType": "Male",
        "PassportNumber": "X90000000",
        "Version": 1
      }
    }
  ],
  "steps": [
    {
      "n": 1,
      "does": "GET /passenger/11111111-1111-4111-8111-111111111116"
    }
  ],
  "expect": [
    "Fails with an invalid-age error when the record is loaded; no passenger returned"
  ]
}
